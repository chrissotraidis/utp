+/*
+ * UT99 Apple host integration: the transparent UIKit host owns hardware and
+ * software keyboard focus while SDL owns the legacy engine event queue. Go
+ * through SDL's real keyboard state machine instead of constructing partial
+ * SDL_Event byte buffers in Swift; UWindow depends on that state for edit-box
+ * characters even though ordinary gameplay bindings accept queued key events.
+ */
+DECLSPEC int SDLCALL SDL_UT99SendKeyboardText(const char *text)
+{
+    const unsigned char *cursor;
+    int posted = 0;
+    if (!text) {
+        return -1;
+    }
+    for (cursor = (const unsigned char *)text; *cursor; ++cursor) {
+        if (*cursor < 0x80) {
+            posted |= SDL_SendKeyboardUnicodeKey(*cursor);
+        }
+    }
+    posted |= SDL_SendKeyboardText(text);
+    return posted;
+}
+
+DECLSPEC int SDLCALL SDL_UT99SendHardwareKey(int pressed, int scancode, int keycode)
+{
+    return SDL_SendKeyboardKeyAndKeycode(pressed ? SDL_PRESSED : SDL_RELEASED,
+                                         (SDL_Scancode)scancode, (SDL_Keycode)keycode);
+}

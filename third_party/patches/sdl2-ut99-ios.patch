diff --git a/src/events/SDL_mouse.c b/src/events/SDL_mouse.c
index a9a89f6..f4d5ce4 100644
--- a/src/events/SDL_mouse.c
+++ b/src/events/SDL_mouse.c
@@ -861,6 +861,52 @@ int SDL_SendMouseButton(SDL_Window *window, SDL_MouseID mouseID, Uint8 state, Ui
     return SDL_PrivateSendMouseButton(window, mouseID, state, button, -1);
 }
 
+/*
+ * UT99 Apple host integration: UIKit keeps the touch overlay in a separate
+ * window above SDL's renderer. Forward absolute host-surface taps through
+ * SDL's stateful mouse path so legacy consumers that inspect both queued
+ * events and SDL_GetMouseState (including UWindow) see one coherent input.
+ * `pressed` is -1 for motion, 0 for release, and 1 for press.
+ */
+DECLSPEC int SDLCALL SDL_UT99SendMousePointer(SDL_Window *window, int x, int y, int pressed, int anchor)
+{
+    SDL_Mouse *mouse = SDL_GetMouse();
+    int posted;
+
+    if (!window) {
+        window = SDL_GetMouseFocus();
+    }
+    if (!window) {
+        return -1;
+    }
+
+    if (SDL_GetMouseFocus() != window) {
+        SDL_SetMouseFocus(window);
+    }
+
+    /* UWindow, SDL_GetMouseState, and UIKit use SDL window points here.
+       Retina drawable pixels and ConfiguredGUIScale remain irrelevant. */
+    posted = 0;
+    if (anchor) {
+        /* UWindow owns a relative software cursor that can drift away from
+           SDL's absolute mouse state. Emit one deliberately oversized delta
+           to clamp that cursor at the upper-left, then move by the requested
+           logical point. The Apple profile compensates SDLDrv's Retina axis
+           scale, making the second delta land point-for-point. */
+        mouse->has_position = SDL_TRUE;
+        mouse->last_x = window->w * 4;
+        mouse->last_y = window->h * 4;
+        posted |= SDL_PrivateSendMouseMotion(window, 0, SDL_FALSE, 0, 0);
+    }
+    posted |= SDL_PrivateSendMouseMotion(window, 0, SDL_FALSE, x, y);
+    if (pressed >= 0) {
+        posted |= SDL_SendMouseButton(window, 0,
+                                      pressed ? SDL_PRESSED : SDL_RELEASED,
+                                      SDL_BUTTON_LEFT);
+    }
+    return posted;
+}
